# ──────────────────────────────────────────────────────────────
# AcadFlow — Environment Variables
# Copy this file to .env for local development.
# NEVER commit a .env file containing real secrets to GitHub.
# ──────────────────────────────────────────────────────────────

# ── Google Gemini API (Only LLM Provider) ──────────────────────
GEMINI_API_KEY=YOUR_NEW_PRIVATE_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Database & Persistent Storage ──────────────────────────────
# Default local paths under data/. On Render with Persistent Disk, use /data/...
DATABASE_PATH=data/campus.db
CHROMA_PERSIST_DIRECTORY=data/chroma
DOCUMENT_STORAGE_PATH=data/uploads

# ── Default Role Passwords (change in production!) ─────────────
ADMIN_PASSWORD=admin123
OFFICER_PASSWORD=officer123
